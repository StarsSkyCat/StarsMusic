{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "playwright.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "packages/contracts/src/**/*.ts",
    "packages/providers/src/**/*.ts",
    "packages/playback/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
