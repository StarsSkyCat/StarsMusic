{
  "name": "starsmusic",
  "version": "1.0.0",
  "private": true,
  "description": "Linux-first cross-platform music player",
  "license": "MIT",
  "homepage": "https://github.com/StarsSkyCat/StarsMusic#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/StarsSkyCat/StarsMusic.git"
  },
  "bugs": {
    "url": "https://github.com/StarsSkyCat/StarsMusic/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "check": "node --check scripts/check.mjs && node scripts/check.mjs",
    "check:docs": "node scripts/check.mjs",
    "setup:electron": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview --skipBuild",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/unit/*.test.ts",
    "test:playback": "node --test tests/integration/mpv.test.ts",
    "probe:netease": "node scripts/probe-netease.ts",
    "probe:netease-discovery": "node scripts/probe-netease-discovery.ts",
    "test:e2e": "electron-vite build && playwright test",
    "probe:kugou": "node scripts/probe-kugou.ts",
    "probe:kugou-discovery": "node scripts/probe-kugou-discovery.ts",
    "test:desktop": "dbus-run-session -- env STARSMUSIC_TEST_BUS=isolated node --test tests/integration/linux-desktop.test.ts",
    "package:arch": "pnpm typecheck && node scripts/package-arch.mjs",
    "test:package": "node scripts/smoke-packaged.mjs",
    "package:win": "pnpm typecheck && node scripts/package-windows.mjs",
    "test:package:win": "node scripts/smoke-windows.mjs",
    "test:installer:win": "node scripts/test-windows-installer.mjs"
  },
  "dependencies": {
    "@lucide/vue": "1.61.0",
    "dbus-next": "0.10.2",
    "qrcode": "1.5.4",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  },
  "desktopName": "org.starsmusic.StarsMusic.desktop",
  "files": [
    "out/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/licenses/"
  ]
}
