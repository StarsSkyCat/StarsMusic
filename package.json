{
  "name": "starsmusic",
  "version": "0.0.0",
  "private": true,
  "description": "Linux-first cross-platform music player",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "check": "node --check scripts/check.mjs && node scripts/check.mjs",
    "check:docs": "node scripts/check.mjs",
    "setup:electron": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview --skipBuild",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/unit/*.test.ts",
    "test:playback": "node --test tests/integration/mpv.test.ts",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
